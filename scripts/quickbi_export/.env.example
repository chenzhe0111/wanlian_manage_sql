# 阿里云 RAM AccessKey（建议专用子账号，只开 quickbi-public:QueryData）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Quick BI 数据服务里创建的 API ID（必填）
QUICKBI_API_ID=

# 新老货主数据服务 ApiId（pt 格式 YYYYMMDD）
QUICKBI_API_ID_NEWOLD=f181db8dd61c

# 注册司机分类型 ApiId（pt=YYYYMMDD）
QUICKBI_API_ID_DRIVER=a136c69111d1

# 可选：指定身份跑行列权限；不填则用组织 owner
QUICKBI_USER_ID=

# 可选：查询条件 JSON，例如 {"mon":"202609"}
QUICKBI_CONDITIONS=

# 可选：返回字段 JSON 数组，例如 ["维度","月运单量_万单"]
QUICKBI_RETURN_FIELDS=

# 输出目录（默认本目录 out/）
QUICKBI_OUT_DIR=

# 文件名前缀
QUICKBI_FILE_PREFIX=quickbi_dataset

# 周度汇总 ApiId（pt=YYYYMMDD）
QUICKBI_API_ID_WEEKLY=6148260aafa3
FEISHU_SHEET_ID_WEEKLY=66mgnV

# 月度/周度漏斗 ApiId（pt=YYYYMMDD；差分还原单周期）
QUICKBI_API_ID_FUNNEL=9cd9d778e4fd
FEISHU_SHEET_ID_FUNNEL=QbfdXI
