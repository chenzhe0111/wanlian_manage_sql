[{"shortcut": "+cells-set", "input": {"sheet_id": "m7B6od", "range": "J4:J12", "cells": [[{"value": "【推演逻辑】峰值固定 → 反推日均 → 月运单", "cell_styles": {"background_color": "#D6E4FF", "font_weight": "bold", "font_size": 11, "horizontal_alignment": "left", "vertical_alignment": "middle", "word_wrap": "auto-wrap"}, "border_styles": {"top": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "bottom": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "left": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "right": {"style": "solid", "weight": "thin", "color": "#91CAFF"}}}], [{"value": "核心：不直接拍线上月量；先锁峰值路径，再线性反推日均与月量。", "cell_styles": {"background_color": "#FFF7E6", "font_size": 10, "horizontal_alignment": "left", "vertical_alignment": "middle", "word_wrap": "auto-wrap"}, "border_styles": {"top": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "bottom": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "left": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "right": {"style": "solid", "weight": "thin", "color": "#91CAFF"}}}], [{"value": "① 固定输入：整体运单、整体峰值（24→27→33→40）；12月整体峰值40万单固定。", "cell_styles": {"background_color": "#FFF7E6", "font_size": 10, "horizontal_alignment": "left", "vertical_alignment": "middle", "word_wrap": "auto-wrap"}, "border_styles": {"top": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "bottom": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "left": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "right": {"style": "solid", "weight": "thin", "color": "#91CAFF"}}}], [{"value": "② 锁定线上峰值：9–12月 = 0.18 / 0.68 / 2.61 / 10.00；12月=整体峰值×25%。", "cell_styles": {"background_color": "#FFF7E6", "font_size": 10, "horizontal_alignment": "left", "vertical_alignment": "middle", "word_wrap": "auto-wrap"}, "border_styles": {"top": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "bottom": {"style": "solid", "weight": "thin", "color": "#91CAFF"}, "left": {"style": "solid", "weight": "thin